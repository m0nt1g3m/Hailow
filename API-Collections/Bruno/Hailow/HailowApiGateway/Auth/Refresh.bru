meta {
  name: Refresh
  type: http
  seq: 3
}

post {
  url: http://localhost:8080/auth/refresh
  body: json
  auth: inherit
}

headers {
  refreshToken: {{JwtRefreshTokenCustomer}}
}

body:json {
  {
      "refreshToken": "{{JwtRefreshTokenCustomer}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
