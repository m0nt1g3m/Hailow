meta {
  name: Logout
  type: http
  seq: 4
}

post {
  url: http://localhost:8080/auth/logout
  body: none
  auth: inherit
}

headers {
  refreshToken: {{JwtRefreshTokenCustomer}}
}

body:json {
  {
      "refreshToken": ""
  }
}

settings {
  encodeUrl: true
  timeout: 0
  forwardAuthorizationHeader: false
}
